{
  "name": "@mean-weasel/bugdrop-board",
  "version": "0.1.2",
  "description": "Embedded, self-hostable ideas/request board.",
  "type": "module",
  "main": "./public/board.js",
  "exports": {
    ".": "./public/board.js",
    "./board": "./public/board.js",
    "./board.js": "./public/board.js"
  },
  "files": [
    "public/board.js",
    "scripts/verify-deployed-worker.js",
    "scripts/verify-clean-room-install.js",
    "scripts/verify-clean-room-install-core.js",
    "scripts/verify-install-smoke-workflow.js",
    "scripts/verify-package-install.js",
    "src/widget/",
    "README.md"
  ],
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "build": "tsc",
    "build:widget": "node scripts/build-widget.js",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build:widget && wrangler deploy --dry-run",
    "deploy:smoke": "node scripts/verify-deployed-worker.js",
    "pack:check": "npm pack --dry-run",
    "release:smoke": "node scripts/verify-package-install.js",
    "install:smoke": "node scripts/verify-clean-room-install.js",
    "install:smoke:workflow": "node scripts/verify-install-smoke-workflow.js",
    "provision:board": "node scripts/provision-board.js",
    "staging:secrets": "node scripts/staging-secrets.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:worker": "npm run build:widget && CI=1 wrangler d1 migrations apply DB --local && wrangler dev --ip 127.0.0.1 --port 8788 --var ENVIRONMENT:e2e --var BOARD_TOKEN_SECRET:e2e-secret --var BOARD_TOKEN_AUDIENCE:bugdrop-board --var BOARD_TOKEN_ISSUER:dummy-host --var ALLOWED_ORIGINS:http://127.0.0.1:5177 --log-level error",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.widget.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit": "npm audit --audit-level=critical",
    "check:actions-node24": "node -e \"const {execSync}=require('node:child_process'); const out=execSync('rg -n \\\\\\\"actions/(checkout|setup-node|cache|upload-artifact)@v4|cloudflare/wrangler-action\\\\\\\" .github/workflows || true',{encoding:'utf8'}); if(out.trim()){ console.error(out); process.exit(1); } console.log('GitHub Actions are Node 24-ready');\"",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "release:rehearsal": "npm run provision:board -- --repo mean-weasel/release-rehearsal --name \"Release Rehearsal\" --local && npm run pack:check && npm run deploy:check && npm run test:e2e && npm run validate && npm run knip && npm run audit && npm run check:actions-node24",
    "prepack": "npm run build:widget",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "^4.12.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.12",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^5.76.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
